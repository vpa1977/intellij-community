diff --git a/bazel/common/proto_common.bzl b/bazel/common/proto_common.bzl
--- a/bazel/common/proto_common.bzl
+++ b/bazel/common/proto_common.bzl
@@ -99,7 +99,7 @@ def _check_collocated(label, proto_info, proto_lang_toolchain_info):
