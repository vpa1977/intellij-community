diff --git a/bazel/private/java_proto_support.bzl b/bazel/private/java_proto_support.bzl
--- a/bazel/private/java_proto_support.bzl
+++ b/bazel/private/java_proto_support.bzl
@@ -7,6 +7,15 @@
 """Support for compiling protoc generated Java code."""
 
-load("@rules_java//java/private:proto_support.bzl", "compile", "merge")  # buildifier: disable=bzl-visibility
+load("@rules_java//java/common:java_common.bzl", "java_common")
+
+# Bazel 7 compat: the rules_java pinned by the system Bazel 7 installation
+# (7.6.5) does not provide java/private/proto_support.bzl. Inline its
+# fallback path, which calls java_common directly.
+def compile(*, injecting_rule_kind, enable_jspecify, include_compilation_info, **kwargs):
+    return java_common.compile(**kwargs)
+
+def merge(providers, *, merge_java_outputs = True, merge_source_jars = True):
+    return java_common.merge(providers)
 
 # The provider is used to collect source and runtime jars in the `proto_library` dependency graph.
 JavaProtoAspectInfo = provider("JavaProtoAspectInfo", fields = ["jars"])
