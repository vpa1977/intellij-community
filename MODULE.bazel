# Bazel 7 compat: the BCR registry patch go_dev_dep.patch for aspect_bazel_lib
# 2.22.0 only applies with a 4-line offset, which Bazel 7's strict patcher
# cannot handle. Override the source and apply locally fixed patch copies.
archive_override(
    module_name = "aspect_bazel_lib",
    integrity = "sha256-/EWc5y8ZjTgiz6+N3NB/Kv73HTVtHw/lE7sWOMUJS70=",
    patch_strip = 1,
    patches = [
        "//:build/aspect-bazel-lib-2.22.0-go-dev-dep-bazel7.patch",
        "//:build/aspect-bazel-lib-2.22.0-module-version.patch",
    ],
    strip_prefix = "bazel-lib-2.22.0",
    urls = "https://github.com/bazel-contrib/bazel-lib/releases/download/v2.22.0/bazel-lib-v2.22.0.tar.gz",
)

